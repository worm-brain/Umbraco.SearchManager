<Project>
  <!-- Central package management: every package version is declared once, here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Umbraco versions per major (UmbracoMajor comes from Directory.Build.props).
    UmbracoPackageRange: what the package compiles against (the floor) and declares to NuGet.
    UmbracoDevVersion: the concrete version sample sites and tests run, pinned with VersionOverride
    where a project references a package that also carries the range.
    UmbracoSearchRange / UmbracoSearchDevVersion: the same for the Umbraco Search add-on, which
    the adapter package builds against. Umbraco Search follows the CMS major in its versions.
  -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoPackageRange>[17.0.0, 18.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>17.7.1</UmbracoDevVersion>
    <UmbracoSearchRange>[17.2.0, 18.0.0)</UmbracoSearchRange>
    <UmbracoSearchDevVersion>17.2.0</UmbracoSearchDevVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoPackageRange>[18.0.0, 19.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>18.2.1</UmbracoDevVersion>
    <UmbracoSearchRange>[18.2.0, 19.0.0)</UmbracoSearchRange>
    <UmbracoSearchDevVersion>18.2.0</UmbracoSearchDevVersion>
  </PropertyGroup>

  <ItemGroup Label="Umbraco">
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Examine.Lucene" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoDevVersion)" />
    <PackageVersion
      Include="Umbraco.Cms.DevelopmentMode.Backoffice"
      Version="$(UmbracoDevVersion)"
    />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Tests only: runs the rebuild history migration and repository against a real SQLite file. -->
    <PackageVersion Include="Umbraco.Cms.Persistence.Sqlite" Version="$(UmbracoDevVersion)" />
  </ItemGroup>

  <ItemGroup Label="Umbraco Search">
    <PackageVersion Include="Umbraco.Cms.Search.Core" Version="$(UmbracoSearchRange)" />
    <!-- A range: the adapter reads the Examine provider's active physical index (ADR 0010). -->
    <PackageVersion Include="Umbraco.Cms.Search.Provider.Examine" Version="$(UmbracoSearchRange)" />
    <PackageVersion Include="Umbraco.Cms.Search.BackOffice" Version="$(UmbracoSearchDevVersion)" />
  </ItemGroup>

  <ItemGroup Label="Security patches">
    <!--
      Patched versions of packages that Umbraco and Umbraco Search bring in transitively, referenced by the
      tests and sample sites only: 10.0.13 fixes the advisories published on 2026-10-13 (CVE-2026-84008 and
      others), which the 17.7 and 18.2 dependency trees still resolve. The packages do not reference them,
      because a consuming site resolves its own. Remove these and their references once UmbracoDevVersion
      and UmbracoSearchDevVersion depend on 10.0.13 or later.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
